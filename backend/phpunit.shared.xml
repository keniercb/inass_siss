<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        Dedicated configuration for the Shared module coverage gate
        (Fase 0 DoD: >= 95 %). The source scope is limited to the module so
        the threshold measures exactly the kernel code, not the whole app.

        AuditTrailObserver (ADR-19) is deliberately excluded: it is
        framework glue (Eloquent events + spatie Activity model +
        config/request helpers) that cannot run without the booted app,
        and its behavior is verified end-to-end by the Security feature
        suite (AuditTrailTest: causer, old/new values, request_id,
        append-only surface). The gate keeps measuring the pure kernel.

        AuditRecorder (ADR-24) is excluded for the same reason: it is
        the extracted writer behind that observer (spatie Activity
        persistence, container config and request state), exercised
        end-to-end by the Security feature suite (AuditTrailTest and
        the user-management bitácora assertions, including secret
        redaction).
    -->
    <testsuites>
        <testsuite name="Shared">
            <directory>app/Modules/Shared/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/Modules/Shared</directory>
        </include>
        <exclude>
            <directory>app/Modules/Shared/Tests</directory>
            <file>app/Modules/Shared/Support/AuditTrailObserver.php</file>
            <file>app/Modules/Shared/Support/AuditRecorder.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1" force="false"/>
        <env name="DB_PORT" value="13306" force="false"/>
        <env name="DB_DATABASE" value="sgp_test" force="false"/>
        <env name="DB_USERNAME" value="sgp" force="false"/>
        <env name="DB_PASSWORD" value="sgp_local_dev" force="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
