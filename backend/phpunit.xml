<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Module-owned tests (plan section S1.4: app/Modules/<M>/Tests). -->
        <testsuite name="Modules">
            <directory>app/Modules</directory>
        </testsuite>
        <!-- Layering conformance (ADR-11): Service + Repository pattern. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Feature tests run against real MySQL 8.4 (ADR-08): local runs use
            the portable server on port 13306; CI overrides these values via
            environment variables (force=false keeps pre-existing env vars).
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1" force="false"/>
        <env name="DB_PORT" value="13306" force="false"/>
        <env name="DB_DATABASE" value="sgp_test" force="false"/>
        <env name="DB_USERNAME" value="sgp" force="false"/>
        <env name="DB_PASSWORD" value="sgp_local_dev" force="false"/>
        <env name="DB_URL" value=""/>
        <env name="L5_SWAGGER_GENERATE_ALWAYS" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
